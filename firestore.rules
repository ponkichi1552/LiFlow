rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prelaunch QA remains available until the administrator enables paid distribution.
    // Store-release startup refuses to run unless this switch is enabled; clients cannot change it.
    function subscriptionAccess() {
      let configuration = /databases/$(database)/documents/serviceConfiguration/billing;
      let entitlement = /databases/$(database)/documents/billingEntitlements/$(request.auth.uid);
      return !exists(configuration) || get(configuration).data.enforced != true
        || exists(entitlement) && get(entitlement).data.userId == request.auth.uid
          && get(entitlement).data.status in ['active', 'grace']
          && get(entitlement).data.validUntil > request.time.toMillis()
          && get(entitlement).data.expiresAt > request.time.toMillis();
    }
    function signedIn() { return request.auth != null && subscriptionAccess(); }
    function groupPath(groupId) { return /databases/$(database)/documents/sharingGroups/$(groupId); }
    function group(groupId) { return get(groupPath(groupId)).data; }
    function afterGroup(groupId) { return getAfter(groupPath(groupId)).data; }
    function memberOf(g) {
      return signedIn() && request.auth.uid in g.memberIds && !(request.auth.uid in g.revokedUserIds) && !g.closed;
    }
    function ownerOf(g) { return memberOf(g) && request.auth.uid == g.ownerUserId; }
    function membershipPath(userId) { return /databases/$(database)/documents/sharingUsers/$(userId)/memberships/current; }
    function liveMember(groupId, userId) {
      let g = group(groupId);
      return userId in g.memberIds && !(userId in g.revokedUserIds) && !g.closed;
    }
    function liveMemberAfter(groupId, userId) {
      let g = afterGroup(groupId);
      return userId in g.memberIds && !(userId in g.revokedUserIds) && !g.closed;
    }
    function heldMembership(m, userId) {
      return liveMember(m.groupId, userId) || m.invitationId != null
        && exists(/databases/$(database)/documents/sharingInvites/$(m.invitationId))
        && get(/databases/$(database)/documents/sharingInvites/$(m.invitationId)).data.status == 'open'
        && get(/databases/$(database)/documents/sharingInvites/$(m.invitationId)).data.expiresAt > request.time
        && exists(/databases/$(database)/documents/sharingInvites/$(m.invitationId)/requests/$(userId));
    }
    function heldMembershipAfter(m, userId) {
      return liveMemberAfter(m.groupId, userId) || m.invitationId != null
        && existsAfter(/databases/$(database)/documents/sharingInvites/$(m.invitationId))
        && getAfter(/databases/$(database)/documents/sharingInvites/$(m.invitationId)).data.status == 'open'
        && getAfter(/databases/$(database)/documents/sharingInvites/$(m.invitationId)).data.expiresAt > request.time
        && existsAfter(/databases/$(database)/documents/sharingInvites/$(m.invitationId)/requests/$(userId));
    }
    function membershipMatches(groupId, userId) {
      let m = getAfter(membershipPath(userId)).data;
      return m.groupId == groupId && m.invitationId == null;
    }
    function singleAddedMembership(groupId, old, next) {
      let added = next.memberIds.removeAll(old.memberIds);
      return added.size() == 0 || added.size() == 1 && membershipMatches(groupId, added[0]);
    }
    function safeId(id) { return id is string && id.matches('^[A-Za-z0-9_.:@-]{1,200}$'); }
    function validRetention(data, through, keyVersion) {
      return !data.keys().hasAny(['retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion'])
        || data.keys().hasAll(['retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion'])
          && data.retentionCutoff is string && data.retentionCutoff.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.retentionThroughSequence is int && data.retentionThroughSequence >= 0 && data.retentionThroughSequence <= through
          && data.retentionKeyVersion is int && data.retentionKeyVersion >= 1 && data.retentionKeyVersion < keyVersion;
    }
    function retentionAdvances(old, next) {
      return next.get('retentionCutoff', '') >= old.get('retentionCutoff', '')
        && next.get('retentionThroughSequence', 0) >= old.get('retentionThroughSequence', 0)
        && next.get('retentionKeyVersion', 0) >= old.get('retentionKeyVersion', 0);
    }
    function retentionMatchesSnapshot(groupId, data) {
      let snapshot = getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(data.snapshotId)).data;
      return data.get('retentionCutoff', '') == snapshot.get('retentionCutoff', '')
        && data.get('retentionThroughSequence', 0) == snapshot.get('retentionThroughSequence', 0)
        && data.get('retentionKeyVersion', 0) == snapshot.get('retentionKeyVersion', 0);
    }
    function coveredByRetention(g, sequence, keyVersion) {
      return g.get('retentionThroughSequence', -1) >= sequence && g.get('retentionKeyVersion', 0) >= keyVersion;
    }
    function validRoot(g) {
      return g.keys().hasOnly(['schemaVersion', 'ownerUserId', 'ownerDeviceId', 'memberIds', 'deviceOwners',
        'keyVersion', 'rosterRevision', 'rosterJson', 'revokedUserIds', 'rotationRequired', 'closed',
        'headSequence', 'lastOperationId', 'snapshotId', 'snapshotThroughSequence', 'retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion', 'createdAt', 'updatedAt'])
        && g.schemaVersion in [1, 2] && safeId(g.ownerUserId) && safeId(g.ownerDeviceId)
        && g.memberIds is list && g.memberIds.size() <= 16 && g.memberIds.toSet().size() == g.memberIds.size()
        && g.deviceOwners is map && g.deviceOwners.size() <= 64
        && g.deviceOwners.values().toSet().hasOnly(g.memberIds)
        && g.keyVersion is int && g.keyVersion > 0 && g.rosterRevision == g.keyVersion
        && g.rosterJson is string && g.rosterJson.size() <= 60000
        && g.revokedUserIds is list && g.revokedUserIds.toSet().hasOnly(g.memberIds)
        && g.revokedUserIds.toSet().size() == g.revokedUserIds.size()
        && g.rotationRequired is bool && (g.revokedUserIds.size() == 0 || g.rotationRequired)
        && g.closed is bool
        && (g.closed ? g.memberIds.size() == 0 && g.deviceOwners.size() == 0
          : g.ownerUserId in g.memberIds && g.deviceOwners[g.ownerDeviceId] == g.ownerUserId)
        && g.headSequence is int && g.headSequence >= 0
        && (g.lastOperationId == null || safeId(g.lastOperationId))
        && (g.snapshotId == null || safeId(g.snapshotId))
        && g.snapshotThroughSequence is int && g.snapshotThroughSequence >= 0 && g.snapshotThroughSequence <= g.headSequence
        && validRetention(g, g.snapshotThroughSequence, g.keyVersion)
        && g.createdAt is timestamp && g.updatedAt == request.time;
    }
    function rosterWritten(groupId, g) {
      return getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/rosters/$(string(g.rosterRevision))).data.rosterJson == g.rosterJson;
    }
    function ownerForWrite(groupId) {
      return exists(groupPath(groupId)) ? ownerOf(group(groupId)) : ownerOf(afterGroup(groupId));
    }
    function validProofDigest(value) { return value is string && value.matches('^[a-f0-9]{64}$'); }
    function recoveryLockPath(groupId) { return /databases/$(database)/documents/sharingGroups/$(groupId)/recoveryLocks/current; }
    function recoveryActive(groupId, g) {
      return g.schemaVersion == 2 && exists(recoveryLockPath(groupId)) && get(recoveryLockPath(groupId)).data.keyVersion == g.keyVersion;
    }
    function validRecoveryCommit(groupId, g, next) {
      let lock = get(recoveryLockPath(groupId)).data;
      let proof = get(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveries/$(next.snapshotId)).data;
      return next.schemaVersion == 2 && next.keyVersion == g.keyVersion + 1
        && next.ownerUserId == g.ownerUserId && next.ownerDeviceId == g.ownerDeviceId
        && next.snapshotId != g.snapshotId && next.snapshotThroughSequence == g.headSequence
        && proof.previousKeyVersion == g.keyVersion && proof.keyVersion == next.keyVersion
        && proof.throughSequence == g.headSequence && proof.snapshotId == next.snapshotId
        && proof.lockId == lock.lockId && proof.reviewDigest == lock.reviewDigest
        && lock.throughSequence == g.headSequence
        && !existsAfter(recoveryLockPath(groupId))
        && !existsAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveryCancellations/$(lock.lockId));
    }
    function receiptMatchesEvent(groupId, operationId, event) {
      let receipt = getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/receipts/$(operationId)).data;
      return receipt.schemaVersion == 2 && receipt.authorUserId == event.authorUserId
        && receipt.authorDeviceId == event.authorDeviceId && receipt.keyVersion == event.keyVersion
        && receipt.uploadSequence == event.uploadSequence && receipt.authorProofDigest == event.authorProofDigest
        && receipt.createdAt == event.createdAt;
    }

    match /sharingGroups/{groupId} {
      allow get: if memberOf(resource.data);
      allow list: if false;
      allow create: if signedIn() && safeId(groupId) && validRoot(request.resource.data)
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && membershipMatches(groupId, request.auth.uid)
        && request.resource.data.deviceOwners.size() == 1
        && request.resource.data.keyVersion == 1 && request.resource.data.headSequence == 0
        && request.resource.data.lastOperationId == null && request.resource.data.snapshotId == null
        && request.resource.data.snapshotThroughSequence == 0 && request.resource.data.revokedUserIds == []
        && !request.resource.data.rotationRequired && !request.resource.data.closed
        && request.resource.data.createdAt == request.time && rosterWritten(groupId, request.resource.data);
      allow update: if validRoot(request.resource.data) && retentionAdvances(resource.data, request.resource.data) && (
        // Each event and its consecutive delivery position commit together. No cursor holes.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headSequence', 'lastOperationId', 'updatedAt'])
          && memberOf(resource.data) && !resource.data.rotationRequired && !recoveryActive(groupId, resource.data)
          && request.resource.data.headSequence == resource.data.headSequence + 1
          && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(request.resource.data.lastOperationId)).data.uploadSequence == request.resource.data.headSequence
          && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(request.resource.data.lastOperationId)).data.authorUserId == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'ownerUserId', 'ownerDeviceId', 'memberIds',
            'deviceOwners', 'keyVersion', 'rosterRevision', 'rosterJson', 'revokedUserIds', 'rotationRequired', 'closed',
            'snapshotId', 'snapshotThroughSequence', 'retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion', 'updatedAt'])
          && ownerOf(resource.data) && (!recoveryActive(groupId, resource.data) || validRecoveryCommit(groupId, resource.data, request.resource.data))
          && request.resource.data.keyVersion == resource.data.keyVersion + 1
          && singleAddedMembership(groupId, resource.data, request.resource.data)
          && request.resource.data.revokedUserIds == [] && !request.resource.data.rotationRequired
          && rosterWritten(groupId, request.resource.data)
          && (request.resource.data.schemaVersion == resource.data.schemaVersion
            || (resource.data.schemaVersion == 1 && request.resource.data.schemaVersion == 2
              && request.resource.data.ownerUserId == resource.data.ownerUserId && request.resource.data.ownerDeviceId == resource.data.ownerDeviceId
              && request.resource.data.memberIds == resource.data.memberIds && request.resource.data.deviceOwners == resource.data.deviceOwners
              && request.resource.data.snapshotId != resource.data.snapshotId
              && request.resource.data.snapshotThroughSequence == resource.data.headSequence
              && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.keyVersion == request.resource.data.keyVersion))
          && ((request.resource.data.snapshotId == resource.data.snapshotId && request.resource.data.snapshotThroughSequence == resource.data.snapshotThroughSequence)
            || (request.resource.data.snapshotThroughSequence == resource.data.headSequence
              && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.keyVersion == request.resource.data.keyVersion
              && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.throughSequence == request.resource.data.snapshotThroughSequence))
          && (request.resource.data.deviceOwners.keys().toSet().difference(resource.data.deviceOwners.keys().toSet()).size() == 0
            || getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.keyVersion == request.resource.data.keyVersion)
          && (request.resource.data.snapshotId == null || retentionMatchesSnapshot(groupId, request.resource.data)))
        // A non-owner can immediately revoke their own cloud access. Sending freezes until rekeyed.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedUserIds', 'rotationRequired', 'updatedAt'])
          && memberOf(resource.data) && request.auth.uid != resource.data.ownerUserId
          && request.resource.data.revokedUserIds.toSet() == resource.data.revokedUserIds.toSet().union([request.auth.uid].toSet())
          && request.resource.data.rotationRequired)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['snapshotId', 'snapshotThroughSequence', 'retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion', 'updatedAt'])
          && ownerOf(resource.data) && !recoveryActive(groupId, resource.data)
          && request.resource.data.snapshotThroughSequence >= resource.data.snapshotThroughSequence
          && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.keyVersion == resource.data.keyVersion
          && getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(request.resource.data.snapshotId)).data.throughSequence == request.resource.data.snapshotThroughSequence
          && retentionMatchesSnapshot(groupId, request.resource.data))
      );
      allow delete: if false;

      match /rosters/{revision} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerForWrite(groupId)
          && request.resource.data.keys().hasOnly(['rosterJson', 'createdAt'])
          && request.resource.data.rosterJson == afterGroup(groupId).rosterJson
          && revision == string(afterGroup(groupId).rosterRevision) && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /events/{operationId} {
        allow read: if memberOf(group(groupId));
        allow create: if memberOf(group(groupId)) && !group(groupId).rotationRequired && !recoveryActive(groupId, group(groupId))
          && safeId(operationId)
          && request.resource.data.schemaVersion == group(groupId).schemaVersion && request.resource.data.authorUserId == request.auth.uid
          && (request.resource.data.schemaVersion == 1
            ? request.resource.data.keys().hasOnly(['schemaVersion', 'authorUserId', 'authorDeviceId', 'keyVersion', 'uploadSequence', 'envelopeJson', 'createdAt'])
            : request.resource.data.keys().hasOnly(['schemaVersion', 'authorUserId', 'authorDeviceId', 'keyVersion', 'uploadSequence', 'envelopeJson', 'authorProofDigest', 'createdAt'])
              && validProofDigest(request.resource.data.authorProofDigest)
              && !exists(/databases/$(database)/documents/sharingGroups/$(groupId)/receipts/$(operationId))
              && receiptMatchesEvent(groupId, operationId, request.resource.data))
          && group(groupId).deviceOwners[request.resource.data.authorDeviceId] == request.auth.uid
          && request.resource.data.keyVersion == group(groupId).keyVersion
          && request.resource.data.envelopeJson is string && request.resource.data.envelopeJson.size() <= 800000
          && request.resource.data.uploadSequence == group(groupId).headSequence + 1
          && afterGroup(groupId).headSequence == request.resource.data.uploadSequence && afterGroup(groupId).lastOperationId == operationId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownerOf(group(groupId)) && !recoveryActive(groupId, group(groupId)) && resource.data.uploadSequence <= group(groupId).snapshotThroughSequence
          && (group(groupId).schemaVersion == 1 || !exists(/databases/$(database)/documents/sharingGroups/$(groupId)/quarantines/$(operationId))
            || coveredByRetention(group(groupId), resource.data.uploadSequence, resource.data.keyVersion));
      }
      match /receipts/{operationId} {
        allow read: if memberOf(group(groupId));
        allow create: if memberOf(group(groupId)) && group(groupId).schemaVersion == 2 && !group(groupId).rotationRequired && !recoveryActive(groupId, group(groupId))
          && safeId(operationId)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'authorUserId', 'authorDeviceId', 'keyVersion', 'uploadSequence', 'authorProofDigest', 'createdAt'])
          && request.resource.data.schemaVersion == 2 && request.resource.data.authorUserId == request.auth.uid
          && group(groupId).deviceOwners[request.resource.data.authorDeviceId] == request.auth.uid
          && request.resource.data.keyVersion == group(groupId).keyVersion
          && validProofDigest(request.resource.data.authorProofDigest) && request.resource.data.createdAt == request.time
          && request.resource.data.uploadSequence == group(groupId).headSequence + 1
          && !exists(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(operationId))
          && afterGroup(groupId).headSequence == request.resource.data.uploadSequence && afterGroup(groupId).lastOperationId == operationId
          && receiptMatchesEvent(groupId, operationId,
            getAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(operationId)).data);
        allow update: if false;
        allow delete: if ownerOf(group(groupId)) && !recoveryActive(groupId, group(groupId)) && coveredByRetention(group(groupId), resource.data.uploadSequence, resource.data.keyVersion);
      }
      match /keyEnvelopes/{keyId} {
        allow read: if memberOf(group(groupId)) && resource.data.userId == request.auth.uid;
        allow create: if ownerForWrite(groupId)
          && request.resource.data.keys().hasOnly(['userId', 'deviceId', 'keyVersion', 'wrappedKeyJson', 'createdAt'])
          && request.resource.data.keyVersion == afterGroup(groupId).keyVersion
          && afterGroup(groupId).deviceOwners[request.resource.data.deviceId] == request.resource.data.userId
          && keyId == string(request.resource.data.keyVersion) + '_' + request.resource.data.deviceId
          && request.resource.data.wrappedKeyJson is string && request.resource.data.wrappedKeyJson.size() <= 10000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownerOf(group(groupId))
          && (!exists(/databases/$(database)/documents/sharingGroups/$(groupId)/keyEnvelopes/$(keyId))
            || (resource.data.keyVersion < group(groupId).keyVersion
              && get(/databases/$(database)/documents/sharingGroups/$(groupId)/snapshots/$(group(groupId).snapshotId)).data.keyVersion == group(groupId).keyVersion));
      }
      match /maintenance/{maintenanceId} {
        allow read: if ownerOf(group(groupId));
        allow create, update: if ownerOf(group(groupId)) && maintenanceId == 'keyCleanup'
          && request.resource.data.keys().hasOnly(['throughKeyVersion']) && request.resource.data.throughKeyVersion is int
          && request.resource.data.throughKeyVersion >= 0 && request.resource.data.throughKeyVersion < group(groupId).keyVersion
          && (!exists(/databases/$(database)/documents/sharingGroups/$(groupId)/maintenance/$(maintenanceId)) || request.resource.data.throughKeyVersion >= resource.data.throughKeyVersion);
        allow delete: if false;
      }
      match /recoveryLocks/{lockId} {
        allow read: if memberOf(group(groupId));
        allow create, update: if ownerOf(group(groupId)) && group(groupId).schemaVersion == 2 && lockId == 'current'
          && request.resource.data.keys().hasOnly(['schemaVersion', 'lockId', 'ownerUserId', 'ownerDeviceId', 'keyVersion', 'throughSequence', 'rosterDigest', 'reviewDigest', 'lockJson', 'createdAt'])
          && request.resource.data.schemaVersion == 1 && safeId(request.resource.data.lockId)
          && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.ownerDeviceId == group(groupId).ownerDeviceId
          && request.resource.data.keyVersion == group(groupId).keyVersion && request.resource.data.throughSequence == group(groupId).headSequence
          && validProofDigest(request.resource.data.rosterDigest) && validProofDigest(request.resource.data.reviewDigest)
          && request.resource.data.lockJson is string && request.resource.data.lockJson.size() <= 12000 && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveryCancellations/$(request.resource.data.lockId))
          && (!exists(recoveryLockPath(groupId)) || resource.data.keyVersion < group(groupId).keyVersion);
        allow delete: if ownerOf(group(groupId)) && lockId == 'current'
          && (existsAfter(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveryCancellations/$(resource.data.lockId))
            || validRecoveryCommit(groupId, group(groupId), afterGroup(groupId)));
      }
      match /recoveryCancellations/{lockId} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerOf(group(groupId)) && group(groupId).schemaVersion == 2 && safeId(lockId)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'lockId', 'keyVersion', 'reviewDigest', 'ownerDeviceId', 'createdAt'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.lockId == lockId
          && request.resource.data.keyVersion == group(groupId).keyVersion && request.resource.data.ownerDeviceId == group(groupId).ownerDeviceId
          && validProofDigest(request.resource.data.reviewDigest) && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /recoveries/{snapshotId} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerOf(group(groupId)) && recoveryActive(groupId, group(groupId)) && safeId(snapshotId)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'snapshotId', 'previousKeyVersion', 'keyVersion', 'throughSequence', 'lockId', 'reviewDigest', 'encryptedHeaderJson', 'createdAt'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.snapshotId == snapshotId
          && request.resource.data.previousKeyVersion == group(groupId).keyVersion && request.resource.data.keyVersion == group(groupId).keyVersion + 1
          && request.resource.data.throughSequence == group(groupId).headSequence
          && request.resource.data.lockId == get(recoveryLockPath(groupId)).data.lockId
          && request.resource.data.reviewDigest == get(recoveryLockPath(groupId)).data.reviewDigest
          && request.resource.data.encryptedHeaderJson is string && request.resource.data.encryptedHeaderJson.size() <= 800000 && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveryCancellations/$(request.resource.data.lockId));
        allow update: if false;
        allow delete: if ownerOf(group(groupId)) && !recoveryActive(groupId, group(groupId)) && coveredByRetention(group(groupId), resource.data.throughSequence, resource.data.keyVersion);
      }
      match /quarantines/{operationId} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerOf(group(groupId)) && recoveryActive(groupId, group(groupId)) && safeId(operationId)
          && request.resource.data.keys().hasOnly(['schemaVersion', 'recoveryId', 'uploadSequence', 'keyVersion', 'rawDigest', 'createdAt'])
          && request.resource.data.schemaVersion == 1 && safeId(request.resource.data.recoveryId) && validProofDigest(request.resource.data.rawDigest)
          && request.resource.data.keyVersion == group(groupId).keyVersion
          && request.resource.data.uploadSequence == get(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(operationId)).data.uploadSequence
          && request.resource.data.keyVersion == get(/databases/$(database)/documents/sharingGroups/$(groupId)/events/$(operationId)).data.keyVersion
          && get(/databases/$(database)/documents/sharingGroups/$(groupId)/recoveries/$(request.resource.data.recoveryId)).data.lockId == get(recoveryLockPath(groupId)).data.lockId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownerOf(group(groupId)) && !recoveryActive(groupId, group(groupId)) && coveredByRetention(group(groupId), resource.data.uploadSequence, resource.data.keyVersion);
      }
      match /acknowledgements/{deviceId} {
        allow read: if memberOf(group(groupId));
        allow create, update: if memberOf(group(groupId))
          && group(groupId).deviceOwners[deviceId] == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'sequence', 'updatedAt'])
          && request.resource.data.userId == request.auth.uid && request.resource.data.sequence is int
          && request.resource.data.sequence >= 0 && request.resource.data.sequence <= group(groupId).headSequence
          && (!exists(/databases/$(database)/documents/sharingGroups/$(groupId)/acknowledgements/$(deviceId)) || request.resource.data.sequence >= resource.data.sequence)
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownerOf(group(groupId));
      }
      match /snapshots/{snapshotId} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerOf(group(groupId)) && safeId(snapshotId)
          && request.resource.data.keys().hasOnly(['keyVersion', 'throughSequence', 'retentionCutoff', 'retentionThroughSequence', 'retentionKeyVersion', 'manifestJson', 'createdAt'])
          && request.resource.data.keyVersion == afterGroup(groupId).keyVersion
          && (!group(groupId).rotationRequired || request.resource.data.keyVersion > group(groupId).keyVersion)
          && request.resource.data.throughSequence is int && request.resource.data.throughSequence >= 0
          && request.resource.data.throughSequence <= group(groupId).headSequence
          && validRetention(request.resource.data, request.resource.data.throughSequence, request.resource.data.keyVersion)
          && request.resource.data.manifestJson is string && request.resource.data.manifestJson.size() <= 100000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownerOf(group(groupId)) && !recoveryActive(groupId, group(groupId)) && snapshotId != group(groupId).snapshotId;
      }
      match /snapshotChunks/{chunkId} {
        allow read: if memberOf(group(groupId));
        allow create: if ownerOf(group(groupId)) && safeId(chunkId)
          && request.resource.data.keys().hasOnly(['snapshotId', 'keyVersion', 'envelopeJson', 'createdAt'])
          && safeId(request.resource.data.snapshotId) && request.resource.data.keyVersion >= group(groupId).keyVersion
          && request.resource.data.keyVersion <= group(groupId).keyVersion + 1
          && (!group(groupId).rotationRequired || request.resource.data.keyVersion > group(groupId).keyVersion)
          && request.resource.data.envelopeJson is string && request.resource.data.envelopeJson.size() <= 800000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
