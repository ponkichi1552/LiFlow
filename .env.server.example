# Copy to .env.server and set the key only on the API host.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
HOST=127.0.0.1
PORT=8787
# Development stays unauthenticated/local. api:public always enables production/public mode.
APPLIANCE_CARE_MODE=development
APPLIANCE_CARE_FIREBASE_PROJECT_ID=
APPLIANCE_CARE_MONTHLY_LIMIT=5
APPLIANCE_CARE_GLOBAL_DAILY_LIMIT=20
# Use workload identity / Application Default Credentials on the server.
# Never put administrator credentials or this API's OpenAI key in EXPO_PUBLIC_ variables.
APPLIANCE_CARE_MAX_CONCURRENT=3
APPLIANCE_CARE_MAX_PER_HOUR=20

# Comma-separated browser origins, if the Expo web client is used.
APPLIANCE_CARE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
