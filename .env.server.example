# Keep the OpenAI key on the analysis worker in public mode and on the local development host in development mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Set an effort supported by OPENAI_MODEL.
OPENAI_REASONING_EFFORT=max
HOST=127.0.0.1
PORT=8787
# Development stays unauthenticated/local. api:public always enables production/public mode.
APPLIANCE_CARE_MODE=development
APPLIANCE_CARE_FIREBASE_PROJECT_ID=
APPLIANCE_CARE_MONTHLY_LIMIT=5
APPLIANCE_CARE_GLOBAL_DAILY_LIMIT=20
# Use workload identity / Application Default Credentials on the server.
# Never put administrator credentials or this API's OpenAI key in EXPO_PUBLIC_ variables.
APPLIANCE_CARE_MAX_CONCURRENT=3
APPLIANCE_CARE_MAX_PER_HOUR=20

# Comma-separated browser origins, if the Expo web client is used.
APPLIANCE_CARE_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Public HTTP API only. Comma-separated SHA-256 hashes of the raw upload public keys.
APPLIANCE_CARE_UPLOAD_KEY_IDS=
# Analysis worker only. Secret JSON array of raw X25519 private keys (64 lowercase hex characters per key).
APPLIANCE_CARE_UPLOAD_PRIVATE_KEYS=

# Public HTTP API only. Keep the DeviceCheck .p8 file and signing secrets in the server's secret store.
APPLIANCE_CARE_DEVICE_SECRET=
APPLIANCE_CARE_APPLE_TEAM_ID=
APPLIANCE_CARE_DEVICECHECK_KEY_ID=
APPLIANCE_CARE_DEVICECHECK_PRIVATE_KEY_FILE=
APPLIANCE_CARE_ANDROID_PLAY_CERT_SHA256=
# Use a separate stable 32-byte hexadecimal secret to keep existing Android device identities across deployments.
APPLIANCE_CARE_ANDROID_DEVICE_ID_KEY=
